# ============================================================================
# 议场 AGORA · 环境变量模板
# 复制为 .env.local 后按需填写。**留空亦可运行** —— 系统会自动切换到
# 确定性 Mock 引擎（demo 模式），无需任何 API Key 即可完整体验全部功能。
# ============================================================================

# ---- LLM 提供方 -------------------------------------------------------------
# 支持任何 OpenAI 兼容接口：
#   DeepSeek  https://api.deepseek.com/v1        deepseek-chat
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   Moonshot  https://api.moonshot.cn/v1         moonshot-v1-8k
#   OpenAI    https://api.openai.com/v1          gpt-4o-mini
AGORA_LLM_BASE_URL=
AGORA_LLM_API_KEY=
AGORA_LLM_MODEL=

# 采样温度（0~1，默认 0.7）
AGORA_LLM_TEMPERATURE=0.7
# 单次请求超时毫秒（默认 60000）
AGORA_LLM_TIMEOUT_MS=60000

# ---- 运行模式 ---------------------------------------------------------------
# auto   : 有 Key 走真实模型，无 Key 自动降级 Mock（默认）
# mock   : 强制 Mock，保证演示/复现的确定性
# live   : 强制真实模型，缺 Key 直接报错（用于自测配置是否正确）
AGORA_ENGINE=auto

# ---- 数据目录 ---------------------------------------------------------------
# 事件溯源日志的落盘路径（默认 ./data/rooms）
AGORA_DATA_DIR=./data/rooms
